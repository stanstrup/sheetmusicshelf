---
interface Props {
  class?: string;
}
---
<div class:list={['staff-divider', Astro.props.class]} aria-hidden="true">
  <svg preserveAspectRatio="none" viewBox="0 0 1440 36" xmlns="http://www.w3.org/2000/svg">
    <line x1="0" y1="7"  x2="1440" y2="7"  stroke="currentColor" stroke-opacity="0.09" stroke-width="1"/>
    <line x1="0" y1="14" x2="1440" y2="14" stroke="currentColor" stroke-opacity="0.09" stroke-width="1"/>
    <line x1="0" y1="21" x2="1440" y2="21" stroke="currentColor" stroke-opacity="0.09" stroke-width="1"/>
    <line x1="0" y1="28" x2="1440" y2="28" stroke="currentColor" stroke-opacity="0.09" stroke-width="1"/>
    <line x1="0" y1="35" x2="1440" y2="35" stroke="currentColor" stroke-opacity="0.09" stroke-width="1"/>
  </svg>
</div>

<style>
  .staff-divider {
    height: 36px;
    overflow: hidden;
  }
  .staff-divider svg {
    width: 100%;
    height: 100%;
  }
</style>
