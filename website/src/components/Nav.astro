---
const base = import.meta.env.BASE_URL;
---
<nav class="nav">
  <a class="nav-brand" href={base}>Sheet&nbsp;Music&nbsp;<span>Shelf</span></a>
  <div class="nav-links">
    <a href="#features">Features</a>
    <a href="#setup">Setup</a>
    <a href="#configuration">Configuration</a>
    <a class="btn-gh" href="https://github.com/stanstrup/sheetmusicshelf">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
      </svg>
      GitHub
    </a>
  </div>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 2.5rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-brand {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--ink);
    letter-spacing: 0.01em;
  }
  .nav-brand span { color: var(--navy); }
  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
  .nav-links a {
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 600;
  }
  .nav-links a:hover { color: var(--ink); text-decoration: none; }
  .btn-gh {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    background: var(--navy);
    color: #fff !important;
    border-radius: 5px;
    font-size: 0.82rem;
    font-weight: 600;
    transition: opacity 0.15s;
  }
  .btn-gh:hover { opacity: 0.85; text-decoration: none !important; }
  @media (max-width: 640px) {
    .nav { padding: 1rem 1.25rem; }
    .nav-links a:not(.btn-gh) { display: none; }
  }
</style>
