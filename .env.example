# Copy to .sheetmusicshelf.env in Z:\docker\compose (the stack gitignores *.env).
# Values here are the ones that must not live in the compose file.

# Signs the browser session cookie.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SMS_SECRET_KEY=

# authentik OIDC client, created as a new provider + application in authentik.
# The issuer itself is set in the compose file.
SMS_OIDC_CLIENT_ID=
SMS_OIDC_CLIENT_SECRET=

# Routing thresholds.  Per-collection overrides are stored on the collection
# row; these are what a newly registered collection starts with.
SMS_AUTO_ACCEPT=0.80
SMS_REVIEW_FLOOR=0.50

# --- .sheetmusicshelf-db.env (separate file) --------------------------------
# The database has no business holding the OIDC secret, so it gets its own file
# with only this in it.  Must match the password in SMS_DATABASE_URL.
# POSTGRES_PASSWORD=
