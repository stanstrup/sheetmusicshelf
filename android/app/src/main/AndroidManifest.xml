<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SheetMusicShelf"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".BrowseActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:label="@string/settings"
            android:parentActivityName=".BrowseActivity" />

        <activity
            android:name=".FilterActivity"
            android:label="@string/filter_title"
            android:parentActivityName=".BrowseActivity" />

        <activity
            android:name=".FacetValuesActivity"
            android:parentActivityName=".FilterActivity" />

        <!-- Landscape is how music is read on a tablet, and the screen must not
             sleep mid-piece: both are handled in the activity itself. -->
        <activity
            android:name=".ReaderActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:parentActivityName=".BrowseActivity" />

    </application>
</manifest>
